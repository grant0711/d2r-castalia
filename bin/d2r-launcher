#!/usr/bin/env python3
"""
bin/d2r-launcher — Launch the Castalia Desktop Launcher GUI.
Starts the local UI bridge (and local SQLite Campaign API if configured for 127.0.0.1:8787
and not already running), then opens a clean app window in Chrome/browser.
"""
import argparse
import os
import shutil
import socket
import subprocess
import sys
import threading
from typing import Optional
import webbrowser

REPO_ROOT = getattr(sys, "_MEIPASS", os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))


def _maybe_exec_origin_release() -> None:
    """
    On Linux dev checkouts, sync a dedicated detached git worktree to `origin/release`
    and exec its bin/d2r-launcher so local `master` work never leaks into live sessions.
    Pass `--dev` (or set CASTALIA_LAUNCHER_DEV=1) to run directly from the current checkout.
    """
    if getattr(sys, "frozen", False) or os.name == "nt":
        return
    if os.environ.get("CASTALIA_RELEASE_WORKTREE") == "1":
        return
    if "--dev" in sys.argv[1:] or os.environ.get("CASTALIA_LAUNCHER_DEV") == "1":
        return
    if not os.path.isdir(os.path.join(REPO_ROOT, ".git")):
        return

    worktree_dir = os.path.expanduser("~/.local/share/castalia-hub/release-worktree")
    try:
        subprocess.run(
            ["git", "-C", REPO_ROOT, "fetch", "--quiet", "origin", "release"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        ref = subprocess.run(
            ["git", "-C", REPO_ROOT, "rev-parse", "--short", "origin/release"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if ref.returncode != 0:
            return
        short_sha = ref.stdout.strip()
        os.makedirs(os.path.dirname(worktree_dir), exist_ok=True)
        if not os.path.exists(os.path.join(worktree_dir, ".git")):
            subprocess.run(
                ["git", "-C", REPO_ROOT, "worktree", "add", "--force", "--detach", worktree_dir, "origin/release"],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=15,
            )
        else:
            subprocess.run(
                ["git", "-C", worktree_dir, "checkout", "--detach", "--force", "origin/release"],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=15,
            )
        target_script = os.path.join(worktree_dir, "bin", "d2r-launcher")
        if os.path.isfile(target_script):
            print(f"[d2r-launcher] Synced to origin/release ({short_sha}) -> {worktree_dir} (pass --dev for local checkout)")
            os.environ["CASTALIA_RELEASE_WORKTREE"] = "1"
            os.execv(sys.executable, [sys.executable, target_script, *sys.argv[1:]])
    except Exception as exc:
        print(f"[d2r-launcher] Warning: could not sync origin/release ({exc}); running local checkout.")


_maybe_exec_origin_release()

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from castalia_hub.core import CastaliaHub
from castalia_hub.local_server import start_local_api_server
from castalia_hub.ui_server import start_ui_server


def _port_open(host: str, port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        return s.connect_ex((host, port)) == 0


def main():
    p = argparse.ArgumentParser(description="Castalia Campaign Launcher GUI")
    p.add_argument("--port", type=int, default=8788, help="Local UI bridge port")
    p.add_argument("--api", help="Override Campaign API URL")
    p.add_argument("--data-dir", help="Override local hub data directory (isolates tokens & profiles)")
    p.add_argument("--prefix", help="Override Wine/Proton prefix name (e.g. mod, acct2)")
    p.add_argument("--name", help="Set initial display name for this launcher instance")
    p.add_argument("--no-browser", action="store_true", help="Do not auto-open browser window")
    p.add_argument("--dev", action="store_true", help="Run directly from local checkout instead of origin/release worktree")
    args = p.parse_args()

    if args.prefix:
        os.environ["D2R_PREFIX"] = args.prefix
    hub = CastaliaHub(data_dir=args.data_dir, api_url=args.api)
    if args.name:
        hub.update_config({"display_name": args.name})

    # Auto-start local SQLite API if pointing at localhost:8787 and nothing is listening yet
    if hub.config["api_url"].startswith("http://127.0.0.1:8787") and not _port_open("127.0.0.1", 8787):
        db_path = os.path.join(hub.data_dir, "campaigns.db")
        api_srv, _ = start_local_api_server(db_path, host="127.0.0.1", port=8787)
        threading.Thread(target=api_srv.serve_forever, daemon=True).start()
        print(f"[d2r-launcher] Started local Campaign API on http://127.0.0.1:8787 ({db_path})")

    ui_srv = start_ui_server(hub, host="127.0.0.1", port=args.port)
    url = f"http://127.0.0.1:{args.port}/"
    print(f"[d2r-launcher] Castalia Launcher UI running at {url}")

    if not args.no_browser:
        browser = (
            shutil.which("google-chrome")
            or shutil.which("chromium")
            or shutil.which("chromium-browser")
            or shutil.which("msedge")
            or shutil.which("chrome")
        )
        if not browser and sys.platform == "win32":
            for cand in (
                r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
                r"C:\Program Files\Microsoft\Edge\Application\msedge.exe",
                r"C:\Program Files\Google\Chrome\Application\chrome.exe",
                r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
            ):
                if os.path.isfile(cand):
                    browser = cand
                    break
        if browser:
            subprocess.Popen([browser, f"--app={url}", "--window-size=1180,800"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            webbrowser.open(url)

    try:
        ui_srv.serve_forever()
    except KeyboardInterrupt:
        print("\n[d2r-launcher] Shutting down.")


def _setup_windows_gui_logging() -> Optional[str]:
    """Under Windows pythonw.exe, sys.stdout/stderr are None; redirect to launcher.log."""
    if sys.platform != "win32":
        return None
    if sys.stdout is not None and sys.stderr is not None:
        return None
    log_dir = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"), "CastaliaHub")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, "launcher.log")
    try:
        fh = open(log_path, "a", encoding="utf-8", buffering=1)
        if sys.stdout is None:
            sys.stdout = fh
        if sys.stderr is None:
            sys.stderr = fh
        return log_path
    except Exception:
        return None


def _show_windows_error(msg: str) -> None:
    if sys.platform != "win32":
        return
    try:
        import ctypes
        ctypes.windll.user32.MessageBoxW(0, msg, "Castalia Launcher Error", 0x10)
    except Exception:
        pass


if __name__ == "__main__":
    _log_path = _setup_windows_gui_logging()
    try:
        main()
    except Exception as _exc:
        import traceback
        _tb = traceback.format_exc()
        if sys.stderr is not None:
            sys.stderr.write(_tb + "\n")
        _hint = f"\n\nFull log: {_log_path}" if _log_path else ""
        _show_windows_error(f"Castalia Launcher failed to start:\n\n{_exc}{_hint}")
        sys.exit(1)
