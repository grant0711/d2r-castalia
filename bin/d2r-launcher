#!/usr/bin/env python3
"""
bin/d2r-launcher — Launch the Castalia Desktop Launcher GUI.
Starts the local UI bridge (and local SQLite Campaign API if configured for 127.0.0.1:8787
and not already running), then opens a clean app window in Chrome/browser.
"""
import argparse
import os
import shutil
import socket
import subprocess
import sys
import threading
import webbrowser

REPO_ROOT = getattr(sys, "_MEIPASS", os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from castalia_hub.core import CastaliaHub
from castalia_hub.local_server import start_local_api_server
from castalia_hub.ui_server import start_ui_server


def _port_open(host: str, port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        return s.connect_ex((host, port)) == 0


def main():
    p = argparse.ArgumentParser(description="Castalia Campaign Launcher GUI")
    p.add_argument("--port", type=int, default=8788, help="Local UI bridge port")
    p.add_argument("--api", help="Override Campaign API URL")
    p.add_argument("--data-dir", help="Override local hub data directory (isolates tokens & profiles)")
    p.add_argument("--prefix", help="Override Wine/Proton prefix name (e.g. mod, acct2)")
    p.add_argument("--name", help="Set initial display name for this launcher instance")
    p.add_argument("--no-browser", action="store_true", help="Do not auto-open browser window")
    args = p.parse_args()

    if args.prefix:
        os.environ["D2R_PREFIX"] = args.prefix
    hub = CastaliaHub(data_dir=args.data_dir, api_url=args.api)
    if args.name:
        hub.update_config({"display_name": args.name})

    # Auto-start local SQLite API if pointing at localhost:8787 and nothing is listening yet
    if hub.config["api_url"].startswith("http://127.0.0.1:8787") and not _port_open("127.0.0.1", 8787):
        db_path = os.path.join(hub.data_dir, "campaigns.db")
        api_srv, _ = start_local_api_server(db_path, host="127.0.0.1", port=8787)
        threading.Thread(target=api_srv.serve_forever, daemon=True).start()
        print(f"[d2r-launcher] Started local Campaign API on http://127.0.0.1:8787 ({db_path})")

    ui_srv = start_ui_server(hub, host="127.0.0.1", port=args.port)
    url = f"http://127.0.0.1:{args.port}/"
    print(f"[d2r-launcher] Castalia Launcher UI running at {url}")

    if not args.no_browser:
        browser = (
            shutil.which("google-chrome")
            or shutil.which("chromium")
            or shutil.which("chromium-browser")
            or shutil.which("msedge")
            or shutil.which("chrome")
        )
        if not browser and sys.platform == "win32":
            for cand in (
                r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
                r"C:\Program Files\Microsoft\Edge\Application\msedge.exe",
                r"C:\Program Files\Google\Chrome\Application\chrome.exe",
                r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
            ):
                if os.path.isfile(cand):
                    browser = cand
                    break
        if browser:
            subprocess.Popen([browser, f"--app={url}", "--window-size=1180,800"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            webbrowser.open(url)

    try:
        ui_srv.serve_forever()
    except KeyboardInterrupt:
        print("\n[d2r-launcher] Shutting down.")


if __name__ == "__main__":
    main()
