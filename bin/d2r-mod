#!/usr/bin/env bash
# Launch Diablo II: Resurrected in Offline Mode (-uid osi -mod custom -txt)
# Default: launches via D2RLoader.exe (in-game Mod Selector & TCP/IP enabled).
# Pass --direct to launch D2R.exe directly with '-uid osi -mod custom -txt -resetofflinemaps'.
source "/home/grant/games/d2r/bin/d2r-common.sh"

DIRECT_MODE=0
if [ "${1:-}" = "--direct" ]; then
    DIRECT_MODE=1
    shift
fi

ensure_proton
export WINEPREFIX="${D2R_ROOT}/prefixes/acct1"
link_shared_game_dir "${WINEPREFIX}"

# Ensure mods/custom save directory has Settings.json and offline test character if not already present
SAVED_BASE="${WINEPREFIX}/pfx/drive_c/users/steamuser/Saved Games/Diablo II Resurrected"
SAVED_MOD="${SAVED_BASE}/mods/custom"
mkdir -p "${SAVED_MOD}"
if [ -f "${SAVED_BASE}/Settings.json" ] && [ ! -f "${SAVED_MOD}/Settings.json" ]; then
    cp -a "${SAVED_BASE}/Settings.json" "${SAVED_MOD}/"
fi
if [ -f "${SAVED_BASE}/TESTER.d2s" ] && [ ! -f "${SAVED_MOD}/TESTER.d2s" ]; then
    cp -a "${SAVED_BASE}/"TESTER.* "${SAVED_MOD}/" 2>/dev/null || true
fi

export LD_PRELOAD="${D2R_ROOT}/runtime/libd2r_offline.so${LD_PRELOAD:+:$LD_PRELOAD}"
cd "${GAME_DIR}"

if [ "${DIRECT_MODE}" = "1" ]; then
    D2R_WIN_EXE='C:\Program Files (x86)\Diablo II Resurrected\D2R.exe'
    echo "[d2r-mod] Launching D2R.exe directly in Offline Mode with '-uid osi -mod custom -txt -resetofflinemaps'..."
    echo "[d2r-mod] Editing directory: /home/grant/games/d2r/my-mod"
    run_proton "${D2R_WIN_EXE}" -uid osi -mod custom -txt -resetofflinemaps "$@"
else
    D2R_LOADER_EXE='C:\Program Files (x86)\Diablo II Resurrected\D2RLoader.exe'
    echo "[d2r-mod] Launching D2RLoader.exe (in-game Mod Selector & TCP/IP enabled)..."
    echo "[d2r-mod] Config: ${GAME_DIR}/d2rloader/config/d2rloader.toml"
    echo "[d2r-mod] Editing directory: /home/grant/games/d2r/my-mod"
    run_proton "${D2R_LOADER_EXE}" "$@"
fi
