#!/usr/bin/env python3
"""
d2r-sorc - one-skill-at-a-time experiment workflow for the Sorceress overhaul.

  map [tree]                         the 1:1 map (vanilla row -> new skill), status, active variant
  show <slug>                        design intent, variants, active patch, built-row diff vs vanilla, notes
  use <slug> <variant>               switch the active variant (instant revert / A-B test)
  variant <slug> <name> [--from V] [-m TEXT]
                                     create a variant (copy of V, default baseline)
  set <slug> <table>/<key>.<col>=<val> [-v VARIANT]
                                     patch one column in a variant (use _clone=<key> for new rows)
  unset <slug> <table>/<key>[.<col>] [-v VARIANT]
  string <slug> name|short|long <text> [-v VARIANT]
  status <slug> stub|wip|tested|done
  build                              rebuild skills tables + verify, print active experiments
  char [--init|--stats|--level N]    reset the SORC character (skills refunded) - close the game first
  commit [-m MSG]                    git commit all sorceress work (checkpoint)
  revert <slug>                      restore this skill's spec + state from the last checkpoint
  check                              validate the 30-slot map/layout and active variants
  funcs [query]                      query indexed skills.txt & missiles.txt server/client functions & pitfalls
  patterns [slug_or_role]            show reusable skill archetype blueprint & parallel template skill
  compact [slug|--all]               prune old inactive variants from specs/*.json (keeps baseline + active)
  test [slug]                        run TDD engine contract, formula linter & stance matrix simulation for a skill (or all 30)

Typical loop:  patterns -> variant -> set -> use -> build -> char -> (play, report) -> status -> compact -> commit
"""
import argparse
import csv
import datetime
import json
import os
import subprocess
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
sys.path.insert(0, os.path.join(ROOT, "tools"))

from mod_builder.common import MOD_EXCEL, VANILLA_EXCEL  # noqa: E402
from mod_builder.classes.sorceress import engine  # noqa: E402
from mod_builder.classes.sorceress.patterns import (  # noqa: E402
    MISSILE_FUNCS,
    SKILL_ARCHETYPES,
    SKILL_FUNCS,
    STANCE_MARKERS,
)
from mod_builder.classes.sorceress.registry import BY_SLUG, PAGE, SLOTS, check_registry, slot_level  # noqa: E402

EXCEL = MOD_EXCEL
VANILLA = VANILLA_EXCEL
SORC_PATHS = ["tools/mod_builder/classes/sorceress", "docs/classes/sorceress.md", "bin/d2r-sorc"]


def die(msg: str):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def slot(slug: str) -> dict:
    if slug == "_shared":
        return {"slug": "_shared", "name": "shared rows", "tree": "-", "row": 0, "col": 0, "vid": 0,
                "vname": "-", "role": "shared helper rows", "design": "states/stats/helper skills shared by several skills"}
    if slug not in BY_SLUG:
        die(f"unknown skill '{slug}'. Try: d2r-sorc map")
    return BY_SLUG[slug]


def variants_of(slug: str) -> dict:
    return engine.load_spec(slug)["variants"]


# ------------------------------------------------------------------------------ map
def cmd_map(args):
    state = engine.load_state()
    trees = [args.tree] if args.tree else list(PAGE)
    for tree in trees:
        print(f"\n== {tree.upper()} (page {PAGE[tree]}) ==")
        print(f"{'slug':16} {'new name':16} {'r.c':4} {'lvl':>3}  {'vanilla row':20} {'id':>3}  {'status':7} variant")
        for s in sorted((x for x in SLOTS if x["tree"] == tree), key=lambda x: (x["row"], x["col"])):
            print(f"{s['slug']:16} {s['name']:16} {s['row']}.{s['col']}  {slot_level(s):>3}  "
                  f"{s['vname']:20} {s['vid']:>3}  {engine.status_of(s['slug'], state):7} "
                  f"{engine.active_variant(s['slug'], state)}")


# ------------------------------------------------------------------------------ show
def read_rows(path: str, key: str) -> dict:
    with open(path, encoding="latin-1") as f:
        rows = list(csv.DictReader(f, delimiter="\t"))
    return {r[key]: r for r in rows if r.get(key)}


def built_diff(s: dict, tables: dict):
    """Print columns that differ between vanilla and the last build for the skill's rows."""
    for table in ("skills.txt", "skilldesc.txt"):
        key = engine.TABLE_KEYS[table]
        try:
            van, mod = read_rows(os.path.join(VANILLA, table), key), read_rows(os.path.join(EXCEL, table), key)
        except FileNotFoundError:
            continue
        keys = [s["vname"]] if table == "skills.txt" else [s["vname"].lower()]
        keys += [k for k in tables.get(table, {}) if k not in keys]
        for k in keys:
            if k not in mod:
                continue
            base = van.get(k, {})
            diffs = [(c, base.get(c, "<new>"), v) for c, v in mod[k].items() if base.get(c) != v and not c.startswith("*")]
            if diffs:
                print(f"  [{table}] {k}:")
                for c, a, b in diffs:
                    print(f"      {c}: {a!r} -> {b!r}")


def cmd_show(args):
    s = slot(args.slug)
    state = engine.load_state()
    var = engine.active_variant(s["slug"], state)
    spec = engine.load_spec(s["slug"])
    print(f"{s['name']}  ({s['slug']})  [{s['tree']} r{s['row']}c{s['col']}, req lvl {slot_level(s)}, {s['role']}]")
    print(f"replaces vanilla id {s['vid']} '{s['vname']}'   status: {engine.status_of(s['slug'], state)}")
    print(f"\nDESIGN: {s['design']}")
    print(f"\nVARIANTS (active: {var}):")
    for name, v in spec["variants"].items():
        mark = "*" if name == var else " "
        print(f" {mark} {name}: {v.get('description', '')}")
    active = spec["variants"][var]
    print(f"\nACTIVE PATCH ({var}):")
    print(json.dumps({k: active[k] for k in active if k != "description"}, indent=2) if len(active) > 1 else "  (none - vanilla behaviour)")
    print("\nBUILT ROWS vs VANILLA (from last build):")
    built_diff(s, active.get("tables", {}))


# ------------------------------------------------------------------------------ edit
def get_variant(slug: str, name: str = None) -> tuple:
    spec = engine.load_spec(slug)
    name = name or engine.active_variant(slug)
    if name not in spec["variants"]:
        die(f"variant '{name}' not found for {slug}: {list(spec['variants'])}")
    return spec, name


def cmd_variant(args):
    slot(args.slug)
    spec = engine.load_spec(args.slug)
    if args.name in spec["variants"]:
        die(f"variant '{args.name}' already exists")
    src = spec["variants"].get(args.src or "baseline")
    if src is None:
        die(f"source variant '{args.src}' not found")
    new = json.loads(json.dumps(src))
    new["description"] = args.m or f"copy of {args.src or 'baseline'}"
    spec["variants"][args.name] = new
    engine.save_spec(args.slug, spec)
    print(f"created {args.slug}:{args.name} (use it with: d2r-sorc use {args.slug} {args.name})")


def cmd_use(args):
    slot(args.slug)
    if args.variant not in variants_of(args.slug):
        die(f"variant '{args.variant}' not found: {list(variants_of(args.slug))}")
    state = engine.load_state()
    state.setdefault(args.slug, {})["variant"] = args.variant
    engine.save_state(state)
    print(f"{args.slug} now uses variant '{args.variant}'. Run: d2r-sorc build")


def parse_target(text: str):
    """'skills.txt/Fire Bolt.mana' -> (table, key, col|None). The column is after the LAST '.'
    only if the table/key part already contains a '/' and the remainder has no further '/'."""
    if "/" not in text:
        die("target must look like <table>/<key>[.<col>]")
    table, rest = text.split("/", 1)
    if table not in engine.TABLE_KEYS:
        die(f"table must be one of {list(engine.TABLE_KEYS)}")
    key, col = (rest.rsplit(".", 1) + [None])[:2] if "." in rest else (rest, None)
    return table, key, col


def cmd_set(args):
    slot(args.slug)
    if "=" not in args.assignment:
        die("use <table>/<key>.<col>=<value>")
    target, value = args.assignment.split("=", 1)
    table, key, col = parse_target(target)
    if not col:
        die("set needs a column: <table>/<key>.<col>=<value>")
    spec, name = get_variant(args.slug, args.v)
    tbl = spec["variants"][name].setdefault("tables", {}).setdefault(table, {})
    tbl.setdefault(key, {})[col] = value
    engine.save_spec(args.slug, spec)
    print(f"{args.slug}:{name}  {table}/{key}.{col} = {value!r}")


def cmd_unset(args):
    slot(args.slug)
    table, key, col = parse_target(args.target)
    spec, name = get_variant(args.slug, args.v)
    tbl = spec["variants"][name].get("tables", {}).get(table, {})
    if key not in tbl:
        die("nothing to unset")
    if col:
        tbl[key].pop(col, None)
        if not tbl[key]:
            tbl.pop(key)
    else:
        tbl.pop(key)
    engine.save_spec(args.slug, spec)
    print(f"{args.slug}:{name}  removed {args.target}")


def cmd_string(args):
    slot(args.slug)
    spec, name = get_variant(args.slug, args.v)
    spec["variants"][name].setdefault("strings", {})[args.field] = args.text.replace("\\n", "\n")
    engine.save_spec(args.slug, spec)
    print(f"{args.slug}:{name} string {args.field} updated")


def cmd_status(args):
    slot(args.slug)
    state = engine.load_state()
    state.setdefault(args.slug, {})["status"] = args.value
    engine.save_state(state)
    print(f"{args.slug}: status = {args.value}")


# ------------------------------------------------------------------------------ build / check
def cmd_check(_args):
    problems = check_registry()
    state = engine.load_state()
    for s in SLOTS:
        v = engine.active_variant(s["slug"], state)
        if v not in variants_of(s["slug"]):
            problems.append(f"{s['slug']}: active variant '{v}' missing")
        if engine.status_of(s["slug"], state) not in engine.STATUSES:
            problems.append(f"{s['slug']}: bad status")
    if problems:
        die("; ".join(problems))
    print("ok: 30 slots, 10 per tree, no cell collisions, variants resolve.")


def cmd_build(_args):
    cmd_check(_args)
    r = subprocess.run([sys.executable, os.path.join(ROOT, "bin/d2r-build-mod.py"), "itemtypes", "skills", "verify"],
                       capture_output=True, text=True)
    tail = (r.stdout + r.stderr).strip().splitlines()
    if r.returncode != 0:
        print("\n".join(tail[-12:]))
        die("build/verify FAILED (the mod folder may be half-written; fix or `d2r-sorc use <slug> baseline`)")
    print(tail[-1][:160] if tail else "built")
    state = engine.load_state()
    changed = [(s, engine.active_variant(s["slug"], state)) for s in SLOTS
               if engine.active_variant(s["slug"], state) != "baseline"]
    print("\nACTIVE EXPERIMENTS:" if changed else "\nNo experiments active (all baseline).")
    for s, v in changed:
        print(f"  {s['name']:16} variant={v}  ({variants_of(s['slug'])[v].get('description', '')})")
    print("\nNext: d2r-sorc char   (refund skill points), then launch the game.")


def cmd_char(args):
    cmd = [sys.executable, os.path.join(ROOT, "bin/d2r-char"), "reset", "SORC"]
    if args.init:
        cmd.append("--init")
    if args.stats:
        cmd.append("--stats")
    if args.level:
        cmd += ["--level", str(args.level)]
    sys.exit(subprocess.call(cmd))


def git(*a):
    return subprocess.run(["git", "-C", ROOT, *a], capture_output=True, text=True)


def cmd_commit(args):
    git("add", *SORC_PATHS, "tools/mod_builder")
    r = git("commit", "-m", args.m or "Sorceress checkpoint")
    print((r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else "nothing to commit")


def cmd_revert(args):
    s = slot(args.slug)
    spec_rel = f"tools/mod_builder/classes/sorceress/specs/{s['slug']}.json"
    r = git("checkout", "HEAD", "--", spec_rel)
    if r.returncode != 0:
        die(r.stderr.strip())
    head_state = git("show", "HEAD:tools/mod_builder/classes/sorceress/state.json")
    if head_state.returncode == 0:
        old = json.loads(head_state.stdout).get(s["slug"])
        state = engine.load_state()
        if old:
            state[s["slug"]] = old
            engine.save_state(state)
    print(f"{s['slug']} restored to last checkpoint. Run: d2r-sorc build")


def cmd_funcs(args):
    q = (args.query or "").lower().strip()
    print("== STANCE MARKERS & CROSS-STANCE FIZZLE GUARDS ==")
    for tree, info in STANCE_MARKERS.items():
        if not q or q in tree or q in json.dumps(info).lower():
            print(f"  {tree:9} | state={info['state']:17} | stat={info['stat']:18}")
            print(f"            | active:   {info['expr']}")
            print(f"            | opposing: {info['opposing_expr']}")
    print("\n== PROVEN SKILLS.TXT (srvstfunc / srvdofunc / cltstfunc / cltdofunc) ==")
    for sf in SKILL_FUNCS:
        if not q or q in json.dumps(sf).lower():
            print(f"\n  [{sf['id']}] {sf['name']}")
            print(f"    srvst={sf['srvstfunc'] or '-'}  srvdo={sf['srvdofunc'] or '-'}  cltst={sf['cltstfunc'] or '-'}  cltdo={sf['cltdofunc'] or '-'}")
            print(f"    Missiles:  {sf['missile_cols']}")
            print(f"    Calcs:     {sf['calcs']}")
            print(f"    Proven in: {sf['proven_in']}")
            print(f"    Pitfalls:  {sf['pitfalls']}")
    print("\n== PROVEN MISSILES.TXT (pSrvDoFunc / pCltDoFunc / pSrvHitFunc / pCltHitFunc) ==")
    for mf in MISSILE_FUNCS:
        if not q or q in json.dumps(mf).lower():
            print(f"  [{mf['id']:10}] {mf['name']}: {mf['notes']}")


def cmd_patterns(args):
    q = (args.target or "").lower().strip()
    if q and q in BY_SLUG:
        s = BY_SLUG[q]
        role = s["role"]
        arch = SKILL_ARCHETYPES.get(role)
        print(f"Skill: {s['name']} ({s['slug']}) — {s['tree'].title()} r{s['row']}c{s['col']} (Lvl {slot_level(s)}), replaces '{s['vname']}' (ID {s['vid']})")
        print(f"Role:  {role}")
        print(f"Design: {s['design']}")
        tm = STANCE_MARKERS[s["tree"]]
        print(f"Stance Marker ({tm['stance_slug']}): {tm['expr']}")
        print(f"Cross-Stance Fizzle Guard: {tm['opposing_expr']} ? <fizzle_val> : (<normal_expr>)")
        if arch:
            t_slug = arch["template_slug"]
            print(f"\nParallel Template Skill: {t_slug} (tools/mod_builder/classes/sorceress/specs/{t_slug}.json)")
            print(f"Functions: {arch['skills_funcs']}")
            print(f"Pattern:   {arch['missile_pattern']}")
        return

    for role, arch in SKILL_ARCHETYPES.items():
        if not q or q in role.lower() or q in json.dumps(arch).lower():
            print(f"\n== Archetype: {role} (Template: {arch['template_slug']}) ==")
            print(f"  Functions:  {arch['skills_funcs']}")
            print(f"  Pattern:    {arch['missile_pattern']}")
            print(f"  Tree Slots: {arch['tree_slots']}")


def cmd_compact(args):
    state = engine.load_state()
    slugs = ["_shared"] + [s["slug"] for s in SLOTS] if args.all else ([args.slug] if args.slug else [])
    if not slugs:
        die("specify a <slug> or --all")
    total_before = 0
    total_after = 0
    pruned_count = 0
    for sl in slugs:
        slot(sl)
        p = engine.spec_path(sl)
        if not os.path.exists(p):
            continue
        sz_before = os.path.getsize(p)
        total_before += sz_before
        spec = engine.load_spec(sl)
        av = engine.active_variant(sl, state)
        variants = spec.get("variants", {})
        keep_keys = []
        if "baseline" in variants:
            keep_keys.append("baseline")
        if av in variants and av not in keep_keys:
            keep_keys.append(av)
        for k in (args.keep or []):
            if k in variants and k not in keep_keys:
                keep_keys.append(k)
        removed = len(variants) - len(keep_keys)
        if removed > 0:
            pruned_count += removed
            spec["variants"] = {k: variants[k] for k in keep_keys}
            engine.save_spec(sl, spec)
        sz_after = os.path.getsize(p)
        total_after += sz_after
    print(f"compacted {len(slugs)} spec file(s): pruned {pruned_count} inactive variant(s), "
          f"{total_before:,} B -> {total_after:,} B ({total_before - total_after:,} B saved)")


def cmd_test(args):
    if ROOT not in sys.path:
        sys.path.insert(0, ROOT)
    from tests.calc_eval import eval_d2_expr, lint_d2_expression
    from tests.fixture import clear_fixture_caches, get_indexed_tables

    clear_fixture_caches()
    idx = get_indexed_tables()
    skills_by_name = idx["skills_by_name"]
    desc_by_name = idx["desc_by_name"]
    missiles_by_name = idx["missiles_by_name"]
    valid_stats = idx["valid_stats"]
    state = engine.load_state()

    targets = [slot(args.slug)] if args.slug else SLOTS
    failures = []
    for meta in targets:
        slug = meta["slug"]
        vname = meta["vname"]
        tree = meta["tree"]
        role = meta["role"]
        av = engine.active_variant(slug, state)
        srow = skills_by_name[vname]
        drow = desc_by_name.get(srow.get("skilldesc", "").strip(), {})

        # 1. Lint all expressions on skill & skilldesc
        for col, val in srow.items():
            if col.startswith(("calc", "cltcalc", "auralen", "aurarange", "aurastatcalc", "passivecalc", "EDmgSym", "ELenSym", "DmgSym", "ToHitCalc")) and val:
                errs = lint_d2_expression(val, skills_by_name, valid_stats, missiles_by_name)
                if errs:
                    failures.append(f"{slug} (skills.txt:{col}): {errs}")
        for dcol, dval in drow.items():
            if dcol.endswith(("cal1", "cal2", "cal3", "cal4", "cal5", "cal6", "cal7", "calc1", "calc2")) and dval:
                errs = lint_d2_expression(dval, skills_by_name, valid_stats, missiles_by_name)
                if errs:
                    failures.append(f"{slug} (skilldesc.txt:{dcol}): {errs}")

        # 2. Simulate stance behavior for non-baseline reworked skills
        if av == "baseline":
            print(f"[STUB] {meta['name']:18} ({slug:16}) variant=baseline (lint OK)")
            continue

        own_marker = STANCE_MARKERS[tree]["stat"]
        stance_vname = BY_SLUG[STANCE_MARKERS[tree]["stance_slug"]]["vname"]
        opp_markers = [STANCE_MARKERS[t]["stat"] for t in STANCE_MARKERS if t != tree]

        if role == "STANCE":
            has_marker = any(srow.get(f"aurastat{i}") == own_marker for i in range(1, 7))
            if not has_marker:
                failures.append(f"{slug}: stance missing aurastat={own_marker!r}")
            c1_l1 = eval_d2_expr(srow.get("calc1", ""), srow, slvl=1, skills_by_name=skills_by_name)
            c1_l20 = eval_d2_expr(srow.get("calc1", ""), srow, slvl=20, skills_by_name=skills_by_name)
            print(f"[PASS] {meta['name']:18} ({slug:16}) variant={av:15} role=STANCE  (marker={own_marker}, boon={c1_l1}%->{c1_l20}%)")
            continue

        if "passive" in role or "dial" in role:
            calc_expr = srow.get("passivecalc1", "").strip() or srow.get("calc1", "").strip() or drow.get("desccalca1", "").strip()
            p_l1 = eval_d2_expr(calc_expr, srow, slvl=1, skills_by_name=skills_by_name)
            p_l20 = eval_d2_expr(calc_expr, srow, slvl=20, skills_by_name=skills_by_name)
            if p_l1 == 0 or abs(p_l20) < abs(p_l1):
                failures.append(f"{slug}: passive invalid scaling (slvl1={p_l1}, slvl20={p_l20})")
            print(f"[PASS] {meta['name']:18} ({slug:16}) variant={av:15} role=PASSIVE (slvl1={p_l1} -> slvl20={p_l20})")
            continue

        if "utility" in role:
            expected_state = STANCE_MARKERS[tree]["state"]
            if srow.get("restrict") != "2" or srow.get("State1") != expected_state:
                failures.append(
                    f"{slug}: mobility utility skill must have restrict='2' and State1={expected_state!r} "
                    f"(got restrict={srow.get('restrict')!r}, State1={srow.get('State1')!r})"
                )
                continue
            print(f"[PASS] {meta['name']:18} ({slug:16}) variant={av:15} role=UTILITY (strictly gated: restrict=2, State1={expected_state})")
            continue

        guarded = []
        for col in ("EDmgSymPerCalc", "ELenSymPerCalc", "auralencalc", "aurarangecalc", "calc1", "calc2", "calc3", "calc4", "cltcalc1"):
            val = srow.get(col, "").strip()
            if opp_markers[0] in val and opp_markers[1] in val:
                guarded.append((f"skills:{col}", srow, val))
        for mcol in ("srvmissile", "srvmissilea", "srvmissileb", "srvmissilec"):
            mname = srow.get(mcol, "").strip()
            if mname and mname in missiles_by_name:
                mrow = missiles_by_name[mname]
                for mf_col in ("Range", "Radius", "EDmgSymPerCalc", "ELenSymPerCalc", "DmgSymPerCalc", " cAlc1", "calc1"):
                    mval = mrow.get(mf_col, "").strip()
                    if opp_markers[0] in mval and opp_markers[1] in mval:
                        guarded.append((f"missile({mname}):{mf_col}", mrow, mval))

        if not guarded:
            failures.append(f"{slug}: active spell missing cross-stance fizzle guard against {opp_markers}")
            continue

        sim_notes = []
        for label, trow, expr in guarded:
            n_val = eval_d2_expr(expr, trow, slvl=10, skill_levels={vname: 10}, stats={}, skills_by_name=skills_by_name)
            m_val = eval_d2_expr(expr, trow, slvl=10, skill_levels={vname: 10, stance_vname: 10}, stats={own_marker: 10}, skills_by_name=skills_by_name)
            oa_val = eval_d2_expr(expr, trow, slvl=10, skill_levels={vname: 10}, stats={opp_markers[0]: 10}, skills_by_name=skills_by_name)
            ob_val = eval_d2_expr(expr, trow, slvl=10, skill_levels={vname: 10}, stats={opp_markers[1]: 10}, skills_by_name=skills_by_name)
            if m_val < n_val:
                failures.append(f"{slug} ({label}): matching stance ({m_val}) < neutral ({n_val})")
            if oa_val > 1 or ob_val > 1:
                failures.append(f"{slug} ({label}): opposing stance failed to fizzle (oppA={oa_val}, oppB={ob_val})")
            sim_notes.append(f"{label}[neutral={n_val}, stance={m_val}, fizzle={oa_val}/{ob_val}]")
        print(f"[PASS] {meta['name']:18} ({slug:16}) variant={av:15} {', '.join(sim_notes)}")

    if failures:
        for f in failures:
            print(f"[FAIL] {f}", file=sys.stderr)
        die(f"{len(failures)} TDD verification check(s) failed")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("map"); p.add_argument("tree", nargs="?", choices=list(PAGE)); p.set_defaults(f=cmd_map)
    p = sub.add_parser("show"); p.add_argument("slug"); p.set_defaults(f=cmd_show)
    p = sub.add_parser("use"); p.add_argument("slug"); p.add_argument("variant"); p.set_defaults(f=cmd_use)
    p = sub.add_parser("variant"); p.add_argument("slug"); p.add_argument("name")
    p.add_argument("--from", dest="src"); p.add_argument("-m"); p.set_defaults(f=cmd_variant)
    p = sub.add_parser("set"); p.add_argument("slug"); p.add_argument("assignment"); p.add_argument("-v")
    p.set_defaults(f=cmd_set)
    p = sub.add_parser("unset"); p.add_argument("slug"); p.add_argument("target"); p.add_argument("-v")
    p.set_defaults(f=cmd_unset)
    p = sub.add_parser("string"); p.add_argument("slug"); p.add_argument("field", choices=["name", "short", "long"])
    p.add_argument("text"); p.add_argument("-v"); p.set_defaults(f=cmd_string)
    p = sub.add_parser("status"); p.add_argument("slug"); p.add_argument("value", choices=list(engine.STATUSES))
    p.set_defaults(f=cmd_status)
    p = sub.add_parser("build"); p.set_defaults(f=cmd_build)
    p = sub.add_parser("check"); p.set_defaults(f=cmd_check)
    p = sub.add_parser("char"); p.add_argument("--init", action="store_true"); p.add_argument("--stats", action="store_true")
    p.add_argument("--level", type=int); p.set_defaults(f=cmd_char)
    p = sub.add_parser("commit"); p.add_argument("-m"); p.set_defaults(f=cmd_commit)
    p = sub.add_parser("revert"); p.add_argument("slug"); p.set_defaults(f=cmd_revert)
    p = sub.add_parser("funcs"); p.add_argument("query", nargs="?"); p.set_defaults(f=cmd_funcs)
    p = sub.add_parser("patterns"); p.add_argument("target", nargs="?"); p.set_defaults(f=cmd_patterns)
    p = sub.add_parser("compact"); p.add_argument("slug", nargs="?"); p.add_argument("--all", action="store_true")
    p.add_argument("--keep", action="append"); p.set_defaults(f=cmd_compact)
    p = sub.add_parser("test"); p.add_argument("slug", nargs="?"); p.set_defaults(f=cmd_test)

    args = ap.parse_args()
    args.f(args)


if __name__ == "__main__":
    main()
