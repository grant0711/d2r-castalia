#!/usr/bin/env python3
"""
bin/d2r-tcp-guard — CLI wrapper around castalia_hub.tcp_guard.D2RTcpGuard.

Usage:
  ./bin/d2r-tcp-guard --listen 127.0.0.1:4001 --target 127.0.0.1:4000
"""
import argparse
import asyncio
import logging
import os
import signal
import sys

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from castalia_hub.tcp_guard import D2RTcpGuard, parse_host_port


async def run_guard(args: argparse.Namespace) -> None:
    lh, lp = parse_host_port(args.listen)
    th, tp = parse_host_port(args.target)
    guard = D2RTcpGuard(
        lh, lp, th, tp,
        peek_ms=args.peek_ms,
        max_conns=args.max_conns,
        burst_limit=args.burst_limit,
        burst_window_s=args.burst_window,
    )
    server = await asyncio.start_server(guard.handle_client, lh, lp)
    logging.info("d2r-tcp-guard listening on %s:%d -> %s:%d (peek=%dms, burst=%d/%gs)",
                 lh, lp, th, tp, args.peek_ms, args.burst_limit, args.burst_window)
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(sig, stop.set)
        except NotImplementedError:
            pass
    async with server:
        await stop.wait()


def main() -> None:
    p = argparse.ArgumentParser(description="TCP protocol guard for D2RLoader hosting")
    p.add_argument("--listen", default="127.0.0.1:4001", help="Guard listen host:port (point playit here)")
    p.add_argument("--target", default="127.0.0.1:4000", help="Local D2RLoader host:port")
    p.add_argument("--peek-ms", type=int, default=120, help="Pre-connect peek window in ms (default: 120)")
    p.add_argument("--max-conns", type=int, default=16, help="Max concurrent bridged connections")
    p.add_argument("--burst-limit", type=int, default=6, help="Max new connections per burst window")
    p.add_argument("--burst-window", type=float, default=10.0, help="Burst window in seconds")
    args = p.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
    asyncio.run(run_guard(args))


if __name__ == "__main__":
    main()
