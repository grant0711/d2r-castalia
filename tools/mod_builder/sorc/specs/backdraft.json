    "final1": {
      "description": "final1: scale pull/blast/ground-fire radius down by ~25% (4 + (lvl-1)/7 -> 4 at lvl 1, 6 at lvl 20; +2 in Conflagration -> 6 at lvl 1, 8 at lvl 20)",
      "no_label": true,
      "strings": {
        "name": "Backdraft",
        "short": "Ignites a burning ground patch that pulls and slows enemies before detonating",
        "long": "Ignites a patch of roaring ground fire at the target location for 2 seconds, pulling nearby enemies toward its center and slowing their movement while burning them before violently detonating in a fiery blast.\nInvestment increases Fire damage, pull/blast radius, movement slow, and slow duration.\nConflagration further expands the pull/blast radius and increases slow potency and duration."
      },
